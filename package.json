{
  "name": "draft-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:web": "vite build",
    "dev:web": "vite --host 127.0.0.1",
    "start:classic": "npm run build && node dist/cli.js",
    "validate:team-evaluation": "npm run build && node dist/teamEvaluationValidation.js --boosts",
    "validate:simulation-v1": "npm run build && node dist/simulationV1Validation.js",
    "test": "npm run build && node --test dist/draftClassic.test.js dist/playerRoleContract.test.js dist/teamEvaluation.test.js dist/teamBoostV1.test.js dist/simulationV1.test.js dist/webApp.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.10",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.3",
    "vite": "^6.4.3"
  }
}
