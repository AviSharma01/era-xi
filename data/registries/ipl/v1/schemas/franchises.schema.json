{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "franchises": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "activeSeasonIds": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "canonicalName": {
            "minLength": 1,
            "type": "string"
          },
          "franchiseId": {
            "minLength": 1,
            "type": "string"
          },
          "relationships": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "relatedFranchiseId": {
                  "minLength": 1,
                  "type": "string"
                },
                "relationshipType": {
                  "enum": [
                    "competition_successor",
                    "competition_predecessor"
                  ],
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "relatedFranchiseId",
                "relationshipType"
              ],
              "type": "object"
            },
            "minItems": 0,
            "type": "array"
          },
          "status": {
            "enum": [
              "canonical"
            ],
            "minLength": 1,
            "type": "string"
          },
          "teamIds": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "franchiseId",
          "canonicalName",
          "activeSeasonIds",
          "teamIds",
          "relationships",
          "status"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "registryVersion": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "minLength": 1,
      "type": "string"
    },
    "sourceArchiveManifestHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "registryVersion",
    "sourceArchiveManifestHash",
    "franchises"
  ],
  "title": "IPL franchises registry",
  "type": "object"
}
