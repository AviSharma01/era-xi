{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "legacySourcePath": {
      "minLength": 1,
      "type": "string"
    },
    "legacySourceSha256": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "metadataVersion": {
      "enum": [
        "ipl-wicketkeeper-metadata/v1"
      ],
      "minLength": 1,
      "type": "string"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonicalCapabilityEvidenceRefs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "canonicalCapabilityStatus": {
            "enum": [
              "CONFIRMED",
              "UNKNOWN"
            ],
            "minLength": 1,
            "type": "string"
          },
          "canonicalDisplayName": {
            "minLength": 1,
            "type": "string"
          },
          "careerStumpings": {
            "minimum": 0,
            "type": "integer"
          },
          "classification": {
            "enum": [
              "SUPPORTED_POSITIVE",
              "UNVERIFIED_POSITIVE",
              "CONFLICTING_NEGATIVE",
              "UNSUPPORTED_NEGATIVE"
            ],
            "minLength": 1,
            "type": "string"
          },
          "ipl2016EvidenceRefs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "ipl2016Stumpings": {
            "minimum": 0,
            "type": "integer"
          },
          "ipl2016UsageEvidenceRefs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "ipl2016UsageStatus": {
            "enum": [
              "CONFIRMED",
              "UNKNOWN"
            ],
            "minLength": 1,
            "type": "string"
          },
          "legacy2016UsageConflict": {
            "type": "boolean"
          },
          "legacyIsWicketkeeper": {
            "type": "boolean"
          },
          "playerId": {
            "minLength": 1,
            "type": "string"
          },
          "stumpingEvidenceRefs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "playerId",
          "canonicalDisplayName",
          "legacyIsWicketkeeper",
          "classification",
          "careerStumpings",
          "stumpingEvidenceRefs",
          "canonicalCapabilityEvidenceRefs",
          "ipl2016Stumpings",
          "ipl2016EvidenceRefs",
          "ipl2016UsageStatus",
          "ipl2016UsageEvidenceRefs",
          "legacy2016UsageConflict",
          "canonicalCapabilityStatus"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "enum": [
        "ipl-wicketkeeper-legacy-migration/v1"
      ],
      "minLength": 1,
      "type": "string"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "conflictingNegatives": {
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "minimum": 0,
          "type": "integer"
        },
        "seasonSpecific2016UsageConflicts": {
          "minimum": 0,
          "type": "integer"
        },
        "supportedPositives": {
          "minimum": 0,
          "type": "integer"
        },
        "unsupportedNegatives": {
          "minimum": 0,
          "type": "integer"
        },
        "unverifiedPositives": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rows",
        "supportedPositives",
        "unverifiedPositives",
        "conflictingNegatives",
        "unsupportedNegatives",
        "seasonSpecific2016UsageConflicts"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "metadataVersion",
    "legacySourcePath",
    "legacySourceSha256",
    "summary",
    "rows"
  ],
  "title": "Legacy keeper migration report",
  "type": "object"
}
