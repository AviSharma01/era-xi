{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "metadataHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "playerDefaults": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assertionId": {
            "minLength": 1,
            "type": "string"
          },
          "bowlingFamily": {
            "enum": [
              "PACE",
              "SPIN",
              "MIXED",
              "UNKNOWN"
            ],
            "minLength": 1,
            "type": "string"
          },
          "canonicalDisplayName": {
            "minLength": 1,
            "type": "string"
          },
          "evidenceRefs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "contentSha256": {
                  "minLength": 1,
                  "pattern": "[0-9a-f]{64}",
                  "type": "string"
                },
                "locator": {
                  "minLength": 1,
                  "type": "string"
                },
                "observedValues": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "sourceFamily": {
                  "enum": [
                    "OFFICIAL_IPL_BCCI",
                    "NATIONAL_CRICKET_BOARD",
                    "ESPNCRICINFO",
                    "STRONG_CRICKET_REFERENCE"
                  ],
                  "minLength": 1,
                  "type": "string"
                },
                "sourceId": {
                  "minLength": 1,
                  "type": "string"
                },
                "url": {
                  "minLength": 1,
                  "pattern": "https://.+",
                  "type": "string"
                }
              },
              "required": [
                "sourceId",
                "sourceFamily",
                "url",
                "locator",
                "observedValues",
                "contentSha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "identityMatch": {
            "additionalProperties": false,
            "properties": {
              "cricsheetId": {
                "minLength": 1,
                "pattern": "[0-9a-f]{8}",
                "type": "string"
              },
              "externalPlayerId": {
                "minLength": 1,
                "type": "string"
              },
              "method": {
                "enum": [
                  "CRICSHEET_REGISTER_EXACT_EXTERNAL_ID",
                  "MANUAL_MULTI_FIELD_MATCH"
                ],
                "minLength": 1,
                "type": "string"
              },
              "registerName": {
                "minLength": 1,
                "type": "string"
              },
              "sourceDateOfBirth": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourcePlayerName": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "method",
              "cricsheetId",
              "externalPlayerId",
              "registerName",
              "sourcePlayerName",
              "sourceDateOfBirth"
            ],
            "type": "object"
          },
          "notes": {
            "minLength": 1,
            "type": "string"
          },
          "playerId": {
            "minLength": 1,
            "pattern": "[0-9a-f]{8}",
            "type": "string"
          },
          "rawBowlingStyles": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "resolutionStatus": {
            "enum": [
              "APPROVED",
              "UNKNOWN",
              "PENDING",
              "CONFLICT"
            ],
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "assertionId",
          "playerId",
          "canonicalDisplayName",
          "bowlingFamily",
          "resolutionStatus",
          "rawBowlingStyles",
          "identityMatch",
          "evidenceRefs",
          "notes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "roleMetadataVersion": {
      "enum": [
        "ipl-era-draft-player-roles/v1"
      ],
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        "ipl-era-draft-bowling-family-manual/v1"
      ],
      "minLength": 1,
      "type": "string"
    },
    "seasonOverrides": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bowlingFamily": {
            "enum": [
              "PACE",
              "SPIN",
              "MIXED",
              "UNKNOWN"
            ],
            "minLength": 1,
            "type": "string"
          },
          "evidenceRefs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "contentSha256": {
                  "minLength": 1,
                  "pattern": "[0-9a-f]{64}",
                  "type": "string"
                },
                "locator": {
                  "minLength": 1,
                  "type": "string"
                },
                "observedValues": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "sourceFamily": {
                  "enum": [
                    "OFFICIAL_IPL_BCCI",
                    "NATIONAL_CRICKET_BOARD",
                    "ESPNCRICINFO",
                    "STRONG_CRICKET_REFERENCE"
                  ],
                  "minLength": 1,
                  "type": "string"
                },
                "sourceId": {
                  "minLength": 1,
                  "type": "string"
                },
                "url": {
                  "minLength": 1,
                  "pattern": "https://.+",
                  "type": "string"
                }
              },
              "required": [
                "sourceId",
                "sourceFamily",
                "url",
                "locator",
                "observedValues",
                "contentSha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "notes": {
            "minLength": 1,
            "type": "string"
          },
          "overrideId": {
            "minLength": 1,
            "type": "string"
          },
          "playerId": {
            "minLength": 1,
            "pattern": "[0-9a-f]{8}",
            "type": "string"
          },
          "rawBowlingStyles": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "resolutionStatus": {
            "enum": [
              "APPROVED",
              "UNKNOWN",
              "PENDING",
              "CONFLICT"
            ],
            "minLength": 1,
            "type": "string"
          },
          "seasonIds": {
            "items": {
              "minLength": 1,
              "pattern": "ipl-[0-9]{4}",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "overrideId",
          "playerId",
          "seasonIds",
          "bowlingFamily",
          "resolutionStatus",
          "rawBowlingStyles",
          "evidenceRefs",
          "notes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accessedDate": {
            "minLength": 1,
            "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}",
            "type": "string"
          },
          "contentSha256": {
            "minLength": 1,
            "pattern": "[0-9a-f]{64}",
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "type": "string"
          },
          "publisher": {
            "minLength": 1,
            "type": "string"
          },
          "sourceFamily": {
            "enum": [
              "IDENTITY_REGISTER",
              "OFFICIAL_IPL_BCCI",
              "NATIONAL_CRICKET_BOARD",
              "ESPNCRICINFO",
              "STRONG_CRICKET_REFERENCE"
            ],
            "minLength": 1,
            "type": "string"
          },
          "sourceId": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "minLength": 1,
            "pattern": "https://.+",
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "sourceFamily",
          "publisher",
          "title",
          "url",
          "accessedDate",
          "contentSha256",
          "locator"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "trackingIssue": {
      "minLength": 1,
      "pattern": "https://github\\.com/.+/issues/[0-9]+",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "roleMetadataVersion",
    "trackingIssue",
    "sources",
    "playerDefaults",
    "seasonOverrides",
    "metadataHash"
  ],
  "type": "object"
}
