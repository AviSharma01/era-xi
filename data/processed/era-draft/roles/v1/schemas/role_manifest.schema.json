{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "rows": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "schemaVersion": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "minLength": 1,
            "pattern": "[0-9a-f]{64}",
            "type": "string"
          },
          "sizeBytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "sizeBytes",
          "rows",
          "schemaVersion"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "bowlingFamilyMetadataHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "bowlingFamilyMetadataSchemaVersion": {
      "enum": [
        "ipl-era-draft-bowling-family-manual/v1"
      ],
      "minLength": 1,
      "type": "string"
    },
    "eligibilityManifestHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "eligibilityVersion": {
      "minLength": 1,
      "type": "string"
    },
    "roleDataAggregateHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "roleManifestHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "roleMetadataVersion": {
      "enum": [
        "ipl-era-draft-player-roles/v1"
      ],
      "minLength": 1,
      "type": "string"
    },
    "schemaFiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "rows": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "schemaVersion": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "minLength": 1,
            "pattern": "[0-9a-f]{64}",
            "type": "string"
          },
          "sizeBytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "sizeBytes",
          "rows",
          "schemaVersion"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "enum": [
        "ipl-era-draft-player-role-manifest/v1"
      ],
      "minLength": 1,
      "type": "string"
    },
    "stage2RegistryAggregateHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "stage2RegistryVersion": {
      "minLength": 1,
      "type": "string"
    },
    "stage3DatasetVersion": {
      "minLength": 1,
      "type": "string"
    },
    "stage3NormalizationManifestHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "stage3NormalizedMatchAggregateHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "stage4AnalyticalManifestHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "stage4DatasetVersion": {
      "minLength": 1,
      "type": "string"
    },
    "trackingIssue": {
      "minLength": 1,
      "pattern": "https://github\\.com/.+/issues/[0-9]+",
      "type": "string"
    },
    "wicketkeeperMetadataManifestHash": {
      "minLength": 1,
      "pattern": "[0-9a-f]{64}",
      "type": "string"
    },
    "wicketkeeperMetadataVersion": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "roleMetadataVersion",
    "trackingIssue",
    "stage2RegistryVersion",
    "stage2RegistryAggregateHash",
    "stage3DatasetVersion",
    "stage3NormalizationManifestHash",
    "stage3NormalizedMatchAggregateHash",
    "stage4DatasetVersion",
    "stage4AnalyticalManifestHash",
    "eligibilityVersion",
    "eligibilityManifestHash",
    "wicketkeeperMetadataVersion",
    "wicketkeeperMetadataManifestHash",
    "bowlingFamilyMetadataSchemaVersion",
    "bowlingFamilyMetadataHash",
    "artifacts",
    "schemaFiles",
    "roleDataAggregateHash",
    "roleManifestHash"
  ],
  "type": "object"
}
